# CrimeWatch AI - Frontend Environment Configuration
# ===================================================

# Backend REST API base URL (Vite environment variables must start with VITE_)
# Local development:
VITE_API_URL=http://localhost:8000
# Production example:
# VITE_API_URL=https://crime-intelligence-api.onrender.com

# WebSocket connection URL (optional; if omitted, automatically derives ws:// or wss:// from VITE_API_URL)
# Local development:
VITE_WS_URL=ws://localhost:8000/ws/live
# Production example:
# VITE_WS_URL=wss://crime-intelligence-api.onrender.com/ws/live
