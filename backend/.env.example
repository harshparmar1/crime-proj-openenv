# CrimeWatch AI - Backend Environment Configuration
# ==================================================

# Database Connection (SQLite default for local dev, PostgreSQL for production)
# SQLite (Local):
DATABASE_URL=sqlite:///./crime_reports.db
# PostgreSQL (Production / Cloud example - Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname

# Security / JWT Secret (minimum 32 random characters in production)
JWT_SECRET=replace-with-a-secure-random-32-char-secret-in-production
JWT_EXPIRE_HOURS=168

# Allowed Frontend Origins for CORS (comma-separated or single domain)
# Set to your deployed Vercel frontend URL in production:
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Police Registration Policy
# Set to true to allow police signups without secret code (dev mode)
ALLOW_OPEN_POLICE_REGISTER=false
# Secret required if ALLOW_OPEN_POLICE_REGISTER=false:
POLICE_REGISTER_SECRET=change-this-police-registration-passphrase

# OpenAI LLM Integration (Optional - chat falls back to database statistics if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email SMTP Server (Optional - if omitted, OTP is displayed in developer responses)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@crimewatch.local
